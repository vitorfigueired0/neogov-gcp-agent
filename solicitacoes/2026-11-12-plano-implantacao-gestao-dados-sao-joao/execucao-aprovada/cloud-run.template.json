{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "gestao-de-dados-api",
    "namespace": "971507433447",
    "annotations": {
      "run.googleapis.com/ingress": "all",
      "run.googleapis.com/maxScale": "3"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/minScale": "0",
          "autoscaling.knative.dev/maxScale": "3"
        }
      },
      "spec": {
        "serviceAccountName": "gestao-de-dados-api-runtime@pm-sao-joao-del-rei-mg.iam.gserviceaccount.com",
        "containerConcurrency": 80,
        "timeoutSeconds": 300,
        "containers": [
          {
            "image": "__IMAGEM_PRODUCAO_POR_DIGEST_PENDENTE__",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              }
            },
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "GOOGLE_CLOUD_PROJECT",
                "value": "pm-sao-joao-del-rei-mg"
              },
              {
                "name": "FIRESTORE_DATABASE_ID",
                "value": "gestao-de-dados"
              },
              {
                "name": "STORAGE_BUCKET",
                "value": "gestao-de-dados-pm-sao-joao-del-rei-mg"
              },
              {
                "name": "FRONTEND_ORIGIN",
                "value": "https://pmsaojoaodelreimg.gestaodedados.neogov.com.br"
              },
              {
                "name": "NEOGOV_AUTH_BASE_URL",
                "value": "https://api.auth.neogov.com.br"
              },
              {
                "name": "NEOGOV_AUTH_TIMEOUT_MS",
                "value": "5000"
              },
              {
                "name": "AUTH_COOKIE_SECURE",
                "value": "true"
              },
              {
                "name": "AUTH_COOKIE_SAME_SITE",
                "value": "lax"
              },
              {
                "name": "NEOGOV_AUTH_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "NEOGOV_AUTH_API_KEY",
                    "key": "__VERSAO_NUMERICA_ENABLED_PENDENTE__"
                  }
                }
              },
              {
                "name": "NEOGOV_AUTH_ALLOWED_ISSUERS",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "NEOGOV_AUTH_ALLOWED_ISSUERS",
                    "key": "__VERSAO_NUMERICA_ENABLED_PENDENTE__"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "traffic": [
      {
        "percent": 100,
        "latestRevision": true
      }
    ]
  }
}
